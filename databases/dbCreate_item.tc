/*

    Each element in the db_item dictionary is another dictionary which defines the data of the item.
    inner dictionary format:

    {
    base: item,
    material?: str,
    model?: str,
    name?: str,
    lore?: list[str],
    glowing?: num = True/False,
    enchantments?: dict[num/str], // dict keys are enchantment names, values are enchantment levels which are formatted
    count?: str,
    function?: str,
    click_sound?: str,
    arguments?: str, // concatenated list, split by ","
    
    }
    
*/

namespace db_item {
    schema: namespace {
        base: item,
        material?: str,
        model?: str,
        name?: str,
        lore?: list[str],
        glowing?: num,
        enchantments?: dict,
        count?: str,
        click_function?: str,
        click_sound?: str,
        arguments?: str,
        arguments_as_tags?: num
    }
}

namespace db_item.menu_previousPage {
    base: item("spectral_arrow"),
    name: "Page %n(menu_page-1)",
    click_function: "menu_previousPage",
    arguments: ""
}