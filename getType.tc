function getType(value: any): str {
    for (line type of ["Number",
                    "String",
                    "Styled Text",
                    "Location",
                    "Item",
                    "List",
                    "Potion effect",
                    "Sound",
                    "Particle",
                    "Vector",
                    "Dictionary"]) {

        if (var.isType(value, type=line type)) {
            return line type;
        }
    }
}