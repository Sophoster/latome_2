declare local "$l": num;

// call within your loop (at the start or end)
function cpu_limiter(max_cpu: num) {
    if (game.microsecondsSinceStartup - local "$l" >= ((num.min(game.playerCount, 8) * 37.5 + 212.5) * max_cpu)) {
        wait;
        local "$l" = game.microsecondsSinceStartup;
    }
}

// call before your loop
function init_cpu_limiter() {
    local "$l" = game.microsecondsSinceStartup;
}