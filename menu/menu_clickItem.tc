function menu_clickItem(button: item) {

    // tags can include:

    // function: str = function_name
    //      the function to call

    // click_sound: str = sound_id/pitch/volume
    //      sound_id is retrieved from the sound database

    // arguments_as_tags?: num = False
    //      if True, will get the value of the argument from the item's tags

    // arguments: str = argument1,argument2,...
    //      the list of arguments to send to the function being called.
    //      will be split into a list by ","


    line button_data = line button.getAllTags();

    if (dict.hasKey(button_data, "click_sound")) {

        // "click_sound" should be in the format "sound_id/pitch/volume"
        // if the sound_id has multiple sounds, their pitches and volumes will be multiplied by the values specified here
        playSound(button_data["click_sound"] as str);
    }

    if !(dict.hasKey(button_data, "function")) {
        return;
    }

    line button_function = button_data["function"];

    if !(dict.hasKey(button_data, "arguments")) {

        // the function name must be prefixed with "i."" to prevent unwanted functions to be called from items
        // also prevents people from calling any function by editing the item's tags
        call "i.%var(button_function)";
        return;
    }

    line button_arguments = str.split(button_data["arguments"] as str, ",");
    line final_arguments = button_arguments;


    if (button_data["arguments_as_tags"] == True) {
        line final_arguments: dict = {};
        for (line argument of button_arguments) {
            final_arguments[argument] = button_data[argument];
        }
    }
    

    call "i.%var(button_function)" (final_arguments);

}